const cache = {};

function getTTL(key) {
  const value = String(key || '').toUpperCase();

  // Gold Scalping - very fresh data
  if (value === 'XAUUSD:5MIN') {
    return 45 * 1000;
  }

  // Gold trend confirmation
  if (value === 'XAUUSD:15MIN') {
    return 2 * 60 * 1000;
  }

  // Other 5M candles
  if (value.endsWith(':5MIN')) {
    return 2 * 60 * 1000;
  }

  // Other 15M candles
  if (value.endsWith(':15MIN')) {
    return 5 * 60 * 1000;
  }

  // Default
  return 5 * 60 * 1000;
}

function getCache(key) {
  const item = cache[key];

  if (!item) return null;

  const ttl = getTTL(key);

  if (Date.now() - item.time > ttl) {
    delete cache[key];

    console.log(
      `♻️ Candle cache expired: ${key}`
    );

    return null;
  }

  return item.data;
}

function setCache(key, data) {
  cache[key] = {
    data,
    time: Date.now()
  };
}

function clearCache(key) {
  if (key) {
    delete cache[key];
    return;
  }

  for (const cacheKey of Object.keys(cache)) {
    delete cache[cacheKey];
  }
}

module.exports = {
  getCache,
  setCache,
  clearCache
};
