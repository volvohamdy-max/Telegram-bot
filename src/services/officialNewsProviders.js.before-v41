const axios = require('axios');

const USER_AGENT =
  'Mozilla/5.0 (compatible; ForexAIBot/1.0; +Telegram economic calendar bot)';

function stripHtml(html) {
  return String(html || '')
    .replace(/<script[\s\S]*?<\/script>/gi, ' ')
    .replace(/<style[\s\S]*?<\/style>/gi, ' ')
    .replace(/&nbsp;/gi, ' ')
    .replace(/&amp;/gi, '&')
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/&ndash;|&mdash;/gi, '-')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function rowsFromTable(html) {
  const rows = [];
  const rowRegex = /<tr\b[^>]*>([\s\S]*?)<\/tr>/gi;
  let rowMatch;

  while ((rowMatch = rowRegex.exec(html))) {
    const cells = [];
    const cellRegex = /<t[dh]\b[^>]*>([\s\S]*?)<\/t[dh]>/gi;
    let cellMatch;

    while ((cellMatch = cellRegex.exec(rowMatch[1]))) {
      cells.push(stripHtml(cellMatch[1]));
    }

    if (cells.length) rows.push(cells);
  }

  return rows;
}

function monthNumber(name) {
  const map = {
    january: 0, february: 1, march: 2, april: 3,
    may: 4, june: 5, july: 6, august: 7,
    september: 8, october: 9, november: 10, december: 11
  };
  return map[String(name || '').toLowerCase()];
}

function parseUsEasternDate(dateText, timeText) {
  // Avoid timezone libraries: convert via Intl-aware runtime offset by constructing
  // a UTC approximation then correcting to America/New_York.
  const match = String(dateText).match(
    /(?:Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)?,?\s*([A-Za-z]+)\s+(\d{1,2}),?\s+(\d{4})/i
  ) || String(dateText).match(/([A-Za-z]+)\s+(\d{1,2}),?\s+(\d{4})/i);

  if (!match) return null;

  const month = monthNumber(match[1]);
  const day = Number(match[2]);
  const year = Number(match[3]);

  if (!Number.isInteger(month) || !day || !year) return null;

  const tm = String(timeText || '').match(/(\d{1,2}):(\d{2})\s*(AM|PM)/i);
  let hour = tm ? Number(tm[1]) : 8;
  const minute = tm ? Number(tm[2]) : 30;
  const ampm = tm ? tm[3].toUpperCase() : 'AM';

  if (ampm === 'PM' && hour !== 12) hour += 12;
  if (ampm === 'AM' && hour === 12) hour = 0;

  // Iteratively convert local America/New_York wall clock to UTC.
  let utc = Date.UTC(year, month, day, hour, minute, 0);
  for (let i = 0; i < 2; i++) {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/New_York',
      year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hour12: false
    }).formatToParts(new Date(utc));

    const obj = Object.fromEntries(parts.map(p => [p.type, p.value]));
    const rendered = Date.UTC(
      Number(obj.year),
      Number(obj.month) - 1,
      Number(obj.day),
      Number(obj.hour),
      Number(obj.minute)
    );
    const wanted = Date.UTC(year, month, day, hour, minute);
    utc += wanted - rendered;
  }

  return new Date(utc);
}

function classifyBls(title) {
  const t = title.toLowerCase();

  if (t.includes('consumer price index')) {
    return { impact: 'high', currency: 'USD', category: 'CPI' };
  }
  if (t.includes('employment situation')) {
    return { impact: 'high', currency: 'USD', category: 'NFP' };
  }
  if (t.includes('producer price index')) {
    return { impact: 'high', currency: 'USD', category: 'PPI' };
  }
  if (t.includes('job openings and labor turnover')) {
    return { impact: 'high', currency: 'USD', category: 'JOLTS' };
  }
  if (t.includes('employment cost index')) {
    return { impact: 'medium', currency: 'USD', category: 'ECI' };
  }
  if (t.includes('import and export price')) {
    return { impact: 'medium', currency: 'USD', category: 'ImportExportPrices' };
  }

  return { impact: 'low', currency: 'USD', category: 'BLS' };
}

async function fetchBlsOfficial() {
  const year = new Date().getUTCFullYear();
  const url = `https://www.bls.gov/schedule/${year}/home.htm`;

  const { data: html } = await axios.get(url, {
    timeout: 20000,
    headers: { 'User-Agent': USER_AGENT }
  });

  const rows = rowsFromTable(html);
  const events = [];

  for (const cells of rows) {
    if (cells.length < 3) continue;

    const dateText = cells[0];
    const timeText = cells[1];
    const title = cells.slice(2).join(' ');

    const when = parseUsEasternDate(dateText, timeText);
    if (!when || !title) continue;

    const meta = classifyBls(title);
    if (meta.impact === 'low') continue;

    events.push({
      provider: 'bls_official',
      providerId: '',
      title,
      currency: meta.currency,
      country: 'United States',
      impact: meta.impact,
      date: when.toISOString(),
      actual: null,
      forecast: null,
      previous: null,
      category: meta.category,
      sourceUrl: url
    });
  }

  return events;
}

function classifyBea(title) {
  const t = title.toLowerCase();

  if (t.includes('personal income and outlays')) {
    return { impact: 'high', currency: 'USD', category: 'PCE' };
  }
  if (t.includes('gdp') || t.includes('gross domestic product')) {
    return { impact: 'high', currency: 'USD', category: 'GDP' };
  }
  if (t.includes('international trade in goods and services')) {
    return { impact: 'medium', currency: 'USD', category: 'TradeBalance' };
  }

  return { impact: 'low', currency: 'USD', category: 'BEA' };
}

async function fetchBeaOfficial() {
  const url = 'https://www.bea.gov/news/schedule';

  const { data: html } = await axios.get(url, {
    timeout: 20000,
    headers: { 'User-Agent': USER_AGENT }
  });

  const rows = rowsFromTable(html);
  const nowYear = new Date().getUTCFullYear();
  const events = [];

  for (const cells of rows) {
    if (cells.length < 3) continue;

    // BEA rows are typically: date | time | type | release
    const dateCell = cells[0];
    const timeCell = cells[1];
    const title = cells[cells.length - 1];

    let dateText = dateCell;
    if (!/\d{4}/.test(dateText)) {
      dateText = `${dateText}, ${nowYear}`;
    }

    const when = parseUsEasternDate(dateText, timeCell);
    if (!when || !title) continue;

    const meta = classifyBea(title);
    if (meta.impact === 'low') continue;

    events.push({
      provider: 'bea_official',
      providerId: '',
      title,
      currency: meta.currency,
      country: 'United States',
      impact: meta.impact,
      date: when.toISOString(),
      actual: null,
      forecast: null,
      previous: null,
      category: meta.category,
      sourceUrl: url
    });
  }

  return events;
}

function parseFomcDates(text, year) {
  const events = [];
  const normalized = String(text).replace(/\s+/g, ' ');

  // Works with date ranges like "September 15-16" or "October 27-28".
  const re = /(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{1,2})(?:-(\d{1,2}))?/gi;
  let m;

  while ((m = re.exec(normalized))) {
    const month = monthNumber(m[1]);
    const firstDay = Number(m[2]);
    const secondDay = Number(m[3] || m[2]);
    if (!Number.isInteger(month)) continue;

    // Scheduled FOMC statement is normally 2:00 PM ET on final meeting day.
    const when = parseUsEasternDate(
      `${m[1]} ${secondDay}, ${year}`,
      '2:00 PM'
    );

    if (!when) continue;

    // Ignore past/far duplicate text.
    const delta = when.getTime() - Date.now();
    if (delta < -35 * 24 * 60 * 60 * 1000) continue;

    events.push({
      provider: 'fed_official',
      providerId: '',
      title: 'FOMC Interest Rate Decision / Statement',
      currency: 'USD',
      country: 'United States',
      impact: 'high',
      date: when.toISOString(),
      actual: null,
      forecast: null,
      previous: null,
      category: 'FOMC',
      sourceUrl: 'https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm'
    });
  }

  // dedupe by timestamp
  return [...new Map(events.map(e => [e.date, e])).values()];
}

async function fetchFedOfficial() {
  const year = new Date().getUTCFullYear();
  const url = 'https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm';

  const { data: html } = await axios.get(url, {
    timeout: 20000,
    headers: { 'User-Agent': USER_AGENT }
  });

  return parseFomcDates(stripHtml(html), year);
}

async function getOfficialCalendar() {
  const providers = [
    ['bls_official', fetchBlsOfficial],
    ['bea_official', fetchBeaOfficial],
    ['fed_official', fetchFedOfficial]
  ];

  const events = [];
  const health = [];

  for (const [name, fetcher] of providers) {
    try {
      const rows = await fetcher();
      events.push(...rows);
      health.push({ provider: name, ok: true, events: rows.length });
      console.log(`🏛️ ${name}: ${rows.length} events`);
    } catch (error) {
      health.push({
        provider: name,
        ok: false,
        events: 0,
        error: error.response?.status || error.message
      });
      console.log(
        `⚠️ Official provider ${name} failed:`,
        error.response?.status || '',
        error.message
      );
    }
  }

  return { events, health };
}

module.exports = {
  getOfficialCalendar,
  fetchBlsOfficial,
  fetchBeaOfficial,
  fetchFedOfficial
};
