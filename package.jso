{
  "name": "telegram-forex-ai-bot",
  "version": "1.0.0",
  "description": "Telegram Forex AI bot built with Node.js, Telegraf, SQLite, and OpenAI-ready services for Termux.",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch src/app.js",
    "db:init": "node src/database/init.js",
    "doctor": "node -e \"require('./src/utils/preflight')(); console.log('Doctor check passed')\""
  },
  "keywords": [
    "telegram",
    "telegraf",
    "forex",
    "ai",
    "termux",
    ""sqlite3": "^5.1.7""
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "telegraf": "^4.16.3"
  },
  "engines": {
    "node": ">=20"
  }
}
